# InsulinTracker Environment Configuration

# Google Apps Script Web App URL (REQUIRED for Google Sheets integration)
# Get this URL from your Google Apps Script deployment
# Example: https://script.google.com/macros/s/AKfycby.../exec
GOOGLE_APPS_SCRIPT_URL=https://script.google.com/macros/s/AKfycbzvCWLgs9G2WnQ0ByrINGtU-cdkYj0FbDzmLk0-cxYpxwbGtWBfX3wWNU-DZ9CfC1aQ/exec

# Development Settings
NODE_ENV=production

# Database Settings (if using traditional database instead)
# DATABASE_URL=your_database_url_here

# Instructions:
# 1. Copy this file to .env in your project root
# 2. Add your Google Apps Script Web App URL
# 3. Set NODE_ENV to "production" when deploying
